{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "requireCommits": true,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Novas funcionalidades"
          },
          {
            "type": "fix",
            "section": "Correções"
          },
          {
            "type": "perf",
            "section": "Desempenho"
          },
          {
            "type": "revert",
            "section": "Reversões"
          },
          {
            "type": "docs",
            "section": "Documentação",
            "effect": "hidden"
          },
          {
            "type": "style",
            "section": "Estilo",
            "effect": "hidden"
          },
          {
            "type": "refactor",
            "section": "Refatoração",
            "effect": "hidden"
          },
          {
            "type": "test",
            "section": "Testes",
            "effect": "hidden"
          },
          {
            "type": "build",
            "section": "Build",
            "effect": "hidden"
          },
          {
            "type": "ci",
            "section": "Integração contínua",
            "effect": "hidden"
          },
          {
            "type": "chore",
            "section": "Manutenção",
            "effect": "hidden"
          }
        ]
      },
      "infile": "CHANGELOG.md"
    }
  }
}
