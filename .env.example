# ===========================================
# Auto Daily App - Environment Variables
# ===========================================

# Hugging Face Inference API Key (Required)
# Get your API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Modelo de chat (Opcional). Padrão: Qwen/Qwen2.5-Coder-7B-Instruct,
# com meta-llama/Llama-3.1-8B-Instruct como alternativa se o modelo não for suportado.
# HUGGINGFACE_MODEL=

# Turso Database (libSQL)
# Use 'file:local.db' para SQLite local durante testes/desenvolvimento
# Ou 'libsql://seu-banco.turso.io' para nuvem
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=generate_a_random_32_byte_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Cofre Criptografado (AES-256-GCM)
# Chave hexadecimal de 32 bytes (64 caracteres hex)
ENCRYPTION_SECRET=generate_a_random_64_char_hex_secret_here

# GitHub OAuth (Opcional para login com GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL pública do aplicativo, definida no build de produção (sem barra de query ou credenciais).
SITE_URL=https://auto-daily-app.vercel.app
