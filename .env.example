# ===========================================
# Auto Daily App - Environment Variables
# ===========================================

# Hugging Face Inference API Key (Required)
# Get your API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# URL pública do aplicativo, definida no build de produção (sem barra de query ou credenciais).
# Sem SITE_URL, a metadata de desenvolvimento usa http://localhost:3000 e não declara canonical.
# SITE_URL=https://seu-dominio.example
